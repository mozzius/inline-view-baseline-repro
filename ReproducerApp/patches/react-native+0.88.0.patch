 using namespace facebook::react;
 
+// [repro] Tell the app which placement the last measurement used, so it can show that the patch is compiled in.
+static void ReproEchoInlineBaselineMode(NSString *mode)
+{
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  if (![mode isEqualToString:[defaults stringForKey:@"ReproInlineBaselineMeasured"]]) {
+    [defaults setObject:mode forKey:@"ReproInlineBaselineMeasured"];
+  }
+}
